{
  "name": "ofp-reader",
  "version": "1.13.1",
  "description": "Interactive pilot-chart reader for SimBrief OFP PDFs. Parses the plan entirely in the browser.",
  "keywords": [
    "simbrief",
    "ofp",
    "flight-plan",
    "aviation",
    "nextjs",
    "pdf"
  ],
  "author": {
    "name": "Mohamed Omar",
    "url": "https://github.com/redomar"
  },
  "license": "UNLICENSED",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.23.0",
  "scripts": {
    "copy-assets": "node scripts/copy-assets.mjs",
    "predev": "pnpm copy-assets",
    "dev": "next dev",
    "prebuild": "pnpm copy-assets",
    "build": "next build",
    "start": "npx serve out",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "flag-icons": "^7.5.0",
    "next": "16.4.0",
    "pdfjs-dist": "^6.4.299",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^10.12.0",
    "eslint-config-next": "16.4.0",
    "prettier": "^3.9.9",
    "topojson-client": "^3.1.0",
    "typescript": "^6.0.3",
    "world-atlas": "^2.0.2"
  }
}
