{
  "name": "ofp-reader",
  "version": "1.3.0",
  "description": "Interactive pilot-chart reader for SimBrief OFP PDFs. Parses the plan entirely in the browser.",
  "keywords": [
    "simbrief",
    "ofp",
    "flight-plan",
    "aviation",
    "nextjs",
    "pdf"
  ],
  "author": {
    "name": "Mohamed Omar",
    "url": "https://github.com/redomar"
  },
  "license": "UNLICENSED",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.23.0",
  "scripts": {
    "copy-assets": "node scripts/copy-assets.mjs",
    "predev": "pnpm copy-assets",
    "dev": "next dev",
    "prebuild": "pnpm copy-assets",
    "build": "next build",
    "start": "npx serve out",
    "lint": "eslint",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "flag-icons": "^7.5.0",
    "next": "16.3.6",
    "pdfjs-dist": "^6.3.289",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.6",
    "typescript": "^5"
  }
}
